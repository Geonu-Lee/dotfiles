#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# Finder → nvim
#   Finder에서 더블클릭한 파일을 Terminal.app 새 창의 nvim 으로 연다.
#   OpenInTerminal.app (AppleScript 래퍼) 이 이 스크립트를 호출한다.
#
#   사용법:  open-in-terminal <파일>
#            open-in-terminal --no-file    파일 없이 셸만
#
#   Terminal.app 은 `open -a` 로 명령을 넘길 수 없어서 osascript 의 `do script`
#   를 쓴다. AppleScript 의 `quoted form of` 가 셸 인용을 처리하므로 공백·
#   따옴표가 든 경로도 안전하다.
# ============================================================================

BIN="/opt/homebrew/bin"
[[ -d "$BIN" ]] || BIN="/usr/local/bin"

file="${1:?열 파일 경로가 필요합니다 (또는 --no-file)}"

if [[ "$file" == "--no-file" ]]; then
    exec open -a Terminal
fi

exec osascript - "$BIN/nvim" "$file" <<'APPLESCRIPT'
on run argv
	set nvimPath to item 1 of argv
	set filePath to item 2 of argv
	tell application "Terminal"
		do script (quoted form of nvimPath & " " & quoted form of filePath)
		activate
	end tell
end run
APPLESCRIPT
